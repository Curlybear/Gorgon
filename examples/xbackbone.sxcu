{
  "Version": "16.0.0",
  "Name": "XBackBone",
  "DestinationType": "ImageUploader, TextUploader, FileUploader",
  "RequestMethod": "POST",
  "RequestURL": "https://xbackbone.example.com/upload",
  "Body": "MultipartFormData",
  "FileFormName": "upload",
  "Arguments": {
    "file": "{filename}",
    "text": "{input}",
    "token": "YOUR_TOKEN"
  },
  "URL": "{regex:\"url\"\\s*:\\s*\"(https?):\\\\?/\\\\?/([^/\\\\\"]+)\\\\?/([^/\\\\\"]+)\\\\?/([^/\\\\\".]+)\\.(\\w+)\"|1}://{regex:\"url\"\\s*:\\s*\"(https?):\\\\?/\\\\?/([^/\\\\\"]+)\\\\?/([^/\\\\\"]+)\\\\?/([^/\\\\\".]+)\\.(\\w+)\"|2}/{regex:\"url\"\\s*:\\s*\"(https?):\\\\?/\\\\?/([^/\\\\\"]+)\\\\?/([^/\\\\\"]+)\\\\?/([^/\\\\\".]+)\\.(\\w+)\"|3}/{regex:\"url\"\\s*:\\s*\"(https?):\\\\?/\\\\?/([^/\\\\\"]+)\\\\?/([^/\\\\\"]+)\\\\?/([^/\\\\\".]+)\\.(\\w+)\"|4}/raw.{regex:\"url\"\\s*:\\s*\"(https?):\\\\?/\\\\?/([^/\\\\\"]+)\\\\?/([^/\\\\\"]+)\\\\?/([^/\\\\\".]+)\\.(\\w+)\"|5}",
  "ThumbnailURL": "{json:url}/raw",
  "DeletionURL": "{json:url}/delete/YOUR_TOKEN",
  "ErrorMessage": "{json:message}"
}
