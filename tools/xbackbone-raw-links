#!/usr/bin/env python3
"""Make imported XBackBone uploaders give raw links (host/user/CODE/raw.ext)
instead of preview pages (host/user/CODE.ext).

Usage: tools/xbackbone-raw-links [file.sxcu ...]
Without arguments, patches every uploader in ~/.config/gorgon/uploaders whose
URL is just the server's json "url" field.
"""
import json
import pathlib
import re
import sys

EXAMPLE = pathlib.Path(__file__).resolve().parent.parent / "examples" / "xbackbone.sxcu"
RAW_URL = json.loads(EXAMPLE.read_text())["URL"]
PLAIN = {"$json:url$", "{json:url}"}


def modern(value):
    # Legacy files ($json:url$) become the current {json:url} syntax so the
    # new URL template parses alongside them.
    if isinstance(value, str):
        return re.sub(r"\$(\w+(?::[^$]*)?)\$", r"{\1}", value)
    if isinstance(value, dict):
        return {k: modern(v) for k, v in value.items()}
    return value


paths = [pathlib.Path(p) for p in sys.argv[1:]] or sorted(
    pathlib.Path.home().glob(".config/gorgon/uploaders/*.sxcu")
)
for path in paths:
    data = json.loads(path.read_text())
    if not sys.argv[1:] and data.get("URL") not in PLAIN:
        continue
    version = str(data.get("Version", "0")).split(".")[0]
    if not version.isdigit() or int(version) < 13:
        data = modern(data)
        data["Version"] = "16.0.0"
    data["URL"] = RAW_URL
    path.write_text(json.dumps(data, indent=2) + "\n")
    print(f"patched {path}")
